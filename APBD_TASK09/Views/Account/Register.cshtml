@model APBD_TASK09.ViewModels.RegisterViewModel

<h2>Register</h2>

<form asp-action="Register" method="post">

    <div>
        <label>Email</label>
        <input asp-for="Email" />
        <span asp-validation-for="Email"></span>
    </div>

    <div>
        <label>Password</label>
        <input asp-for="Password" type="password" />
        <span asp-validation-for="Password"></span>
    </div>

    <button type="submit">
        Register
    </button>

</form>

<a asp-action="Login">
    Login
</a>